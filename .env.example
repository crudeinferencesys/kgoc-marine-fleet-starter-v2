# Local Development Defaults (SQLite + Django Debug)
DEBUG=True
DJANGO_SECRET_KEY=dev-insecure-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# In-App Gemini AI Bonus Feature (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Production Cloud SQL PostgreSQL (Cloud Run injects/uses Unix socket)
# CLOUD_SQL_CONNECTION_NAME=project-id:me-central1:kgoc-pg
# DB_NAME=kgoc_fleet
# DB_USER=kgoc_app
# DB_PASSWORD=replace-with-strong-password

# Optional alternative single connection URL (e.g., local Postgres / Cloud SQL Proxy)
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/kgoc_fleet
